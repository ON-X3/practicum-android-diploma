<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_search"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.MainFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/CustomToolbarStyle"
        android:minHeight="@dimen/height64dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/search">
        <ImageView
            android:id="@+id/addFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|end"
            android:layout_marginEnd="24dp"
            android:src="@drawable/ic_filter_off_24"
            />
    </com.google.android.material.appbar.MaterialToolbar>
        android:layout_height="match_parent" />

    <FrameLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/height48dp"
        android:orientation="vertical"
        android:layout_marginVertical="@dimen/margin8dp"
        android:layout_marginHorizontal="@dimen/margin16dp">

        <EditText
            android:id="@+id/searchInputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/height56dp"
            android:imeOptions="actionDone"
            android:singleLine="true"
            style="@style/searchDisplayText"
            />

        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|end"
            android:layout_marginEnd="24dp"
            android:src="@drawable/ic_close_24"
            android:visibility="gone"
            app:tint="@color/gray"
            />

    </FrameLayout>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="@dimen/margin156dp"
        android:src="@drawable/il_search"/>

</LinearLayout>
