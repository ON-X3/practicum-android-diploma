<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="9dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/logo"
        android:layout_width="@dimen/company_logo_size"
        android:layout_height="@dimen/company_logo_size"

        android:padding="@dimen/company_logo_stoke_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/logo_image"
        app:strokeWidth="@dimen/company_logo_stoke_width"
        app:strokeColor="@color/lightGray"
        android:scaleType="centerInside"
        tools:src="@drawable/logo_placeholder_32" />

    <TextView
        android:id="@+id/vacancyNameAndCity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="@style/TextAppearanceMedium22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/logo"
        app:layout_constraintTop_toTopOf="@id/logo"
        tools:text="Разработчик на С++ в команду внутренних сервисов, Москва" />

    <TextView
        android:id="@+id/company"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearanceRegular16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/vacancyNameAndCity"
        app:layout_constraintTop_toBottomOf="@id/vacancyNameAndCity"
        tools:text="Авто.ру" />

    <TextView
        android:id="@+id/salary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearanceRegular16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/vacancyNameAndCity"
        app:layout_constraintTop_toBottomOf="@id/company"
        tools:text="от 40 000 до 80 000" />


</androidx.constraintlayout.widget.ConstraintLayout>
