<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/nameIndustry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Авиаперевозки"
            android:textColor="?attr/colorOnBackground"
            android:layout_marginVertical="14.5dp"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="19sp"
            android:layout_marginStart="@dimen/margin16dp" />

        <RadioButton
            android:id="@+id/radioButton"
            android:layout_width="@dimen/height48dp"
            android:layout_height="@dimen/height48dp"
            android:layout_gravity="end"
            app:buttonTint="@color/blue"
            />

    </FrameLayout>


</LinearLayout>