<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.FiltersFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/filter_settings" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/filter_area"
        style="@style/filterButton"
        android:layout_width="@dimen/height0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/basic_padding"
        android:drawableEnd="@drawable/ic_arrow_forward_24"
        android:text="@string/area_filter"
        app:layout_constraintBottom_toBottomOf="@id/areaValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <TextView
        android:id="@+id/areaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_padding"
        android:layout_marginTop="12.5dp"
        android:text="@string/area_filter"
        android:textAppearance="@style/TextAppearanceRegular12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/filter_area" />

    <TextView
        android:id="@+id/areaValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_padding"
        android:layout_marginEnd="56dp"
        android:paddingBottom="12.5dp"
        android:textAppearance="@style/TextAppearanceRegular16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/areaLabel" />

    <ImageView
        android:id="@+id/clearArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/basic_padding"
        android:src="@drawable/ic_close_24"
        app:layout_constraintBottom_toBottomOf="@id/filter_area"
        app:layout_constraintEnd_toEndOf="@id/filter_area"
        app:layout_constraintTop_toTopOf="@id/filter_area" />


    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/filter_industry"
        style="@style/filterButton"
        android:layout_width="@dimen/height0dp"
        android:layout_height="0dp"
        android:drawableEnd="@drawable/ic_arrow_forward_24"
        android:text="@string/industry_filter"
        app:layout_constraintBottom_toBottomOf="@id/industryValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_area" />

    <TextView
        android:id="@+id/industryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_padding"
        android:layout_marginTop="12.5dp"
        android:text="@string/industry_filter"
        android:textAppearance="@style/TextAppearanceRegular12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/filter_industry" />

    <TextView
        android:id="@+id/industryValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/basic_padding"
        android:layout_marginEnd="56dp"
        android:paddingBottom="12.5dp"
        android:textAppearance="@style/TextAppearanceRegular16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/industryLabel" />

    <ImageView
        android:id="@+id/clearIndustry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/basic_padding"
        android:src="@drawable/ic_close_24"
        app:layout_constraintBottom_toBottomOf="@id/filter_industry"
        app:layout_constraintEnd_toEndOf="@id/filter_industry"
        app:layout_constraintTop_toTopOf="@id/filter_industry" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/salaryInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin16dp"
        android:layout_marginVertical="@dimen/margin24dp"
        android:background="@drawable/rounded_textview"
        android:paddingHorizontal="@dimen/margin16dp"
        android:paddingVertical="@dimen/margin8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_industry">

        <TextView
            android:id="@+id/salaryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_regular"
            android:text="@string/salary_tag"
            android:textColor="?attr/hintTextColor"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/salaryInputText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/ys_text_regular"
            android:hint="@string/salary_hint"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="@color/uniBlack"
            android:textColorHint="?attr/hintTextColor"
            android:textCursorDrawable="@drawable/cursor"
            android:textSize="@dimen/text16Sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/salaryLabel" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/clearSalary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/basic_padding"
        android:src="@drawable/ic_close_24"
        app:layout_constraintBottom_toBottomOf="@id/salaryInputContainer"
        app:layout_constraintEnd_toEndOf="@id/salaryInputContainer"
        app:layout_constraintTop_toTopOf="@id/salaryInputContainer"
        app:tint="@color/uniBlack" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/hideWithoutSalary"
        style="@style/filterButton"
        android:layout_width="@dimen/height0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin24dp"
        android:drawableEnd="@drawable/ic_check_box_off_24"
        android:drawableTint="@color/blue"
        android:text="@string/hide_Wo_Salary"
        android:textColor="@color/ypBlack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/salaryInputContainer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/applyFilters"
        style="@style/applyFiltersButton"
        android:layout_width="@dimen/height0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingVertical="20dp"
        android:text="@string/apply_filters"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/dropFilters"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dropFilters"
        style="@style/dropFiltersButton"
        android:layout_width="@dimen/height0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin16dp"
        android:layout_marginBottom="@dimen/margin24dp"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingVertical="20dp"
        android:text="@string/drop_filters"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
