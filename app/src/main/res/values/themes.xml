<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PracticumAndroidDiploma" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/ypWhite</item>
        <item name="colorSurface">@color/ypWhite</item>
        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnSurfaceVariant">@color/gray</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
        <!-- Основной цвет текста на экране и карточках -->
        <item name="colorOnBackground">@color/ypBlack</item>
        <item name="colorOnSurface">@color/ypBlack</item>
        <!-- цвета навбара и статусбара -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/ypWhite</item>
        <item name="android:navigationBarColor">@color/ypWhite</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.PracticumAndroidDiploma" parent="Base.Theme.PracticumAndroidDiploma" />
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <!-- убирает овальные выделение у иконки в bottombar -->
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>
</resources>
