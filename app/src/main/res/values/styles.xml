<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NavItemTextStyle">
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ToolbarStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
        <item name="contentInsetStart">@dimen/toolbar_text_padding_without_navigation</item>
        <item name="contentInsetStartWithNavigation">@dimen/toolbar_text_padding_with_navigation</item>
        <item name="titleTextAppearance">@style/TextAppearanceMedium22</item>
    </style>
    
    <style name="TextAppearanceMedium22" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearanceRegular16" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="logo_image">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/company_logo_corner_radius</item>
    </style>
</resources>
